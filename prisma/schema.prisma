// Prisma Schema para Agenda de Consultas Médicas (MedAgenda)
// Configurado para PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctors Doctor[]

  @@map("specialties")
}

model Doctor {
  id          String    @id @default(uuid())
  name        String
  crm         String    @unique
  specialtyId String    @map("specialty_id")
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  phone       String
  email       String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([crm])
  @@index([name])
  @@index([specialtyId])
  @@index([active])
  @@map("doctors")
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  cpf       String   @unique
  birthDate DateTime @map("birth_date")
  gender    Gender   @default(OUTRO)
  phone     String
  email     String
  address   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([cpf])
  @@index([name])
  @@map("patients")
}

model Appointment {
  id        String            @id @default(uuid())
  patientId String            @map("patient_id")
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId  String            @map("doctor_id")
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  date      DateTime          @db.Date
  time      String            @db.VarChar(5) // Format: "HH:mm"
  duration  Int               @default(30) // In minutes
  reason    String
  notes     String?
  status    AppointmentStatus @default(AGENDADA)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([doctorId, date, time], name: "unique_doctor_slot")
  @@unique([patientId, date, time], name: "unique_patient_slot")
  @@index([date])
  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}
